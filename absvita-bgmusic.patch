+    bgmusic_init(DATA);
+    {
+        char bg_id[40];
+        double bg_pos = 0, bg_dur = 0;
+        if (bgmusic_reconcile(bg_id, sizeof bg_id, &bg_pos, &bg_dur))
+            app_record_bg_progress(bg_id, bg_pos, bg_dur);
+    }
